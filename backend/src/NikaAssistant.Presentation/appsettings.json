{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "%USERPROFILE%\\NikaAssistant\\Logs",
      "RetainedDays": 30
    }
  },
  "AllowedHosts": "*",
  "Autostart": {
    "Enabled": true,
    "Name": "NikaAssistant"
  },
  "StartupPopup": {
    "Enabled": true
  },
  "Llm": {
    "Provider": "Gemini",
    "ApiKey": "",
    "Model": "gemini-3.5-flash-lite",
    "FallbackModels": [ "gemini-3.5-flash", "gemini-3.8-flash", "gemini-3.7-flash", "gemini-3.6-flash", "gemini-3.1-flash-lite", "gemini-3.1-pro-preview", "gemma-4-26b-a4b-it", "gemma-4-31b-it" ],
    "BaseUrl": "",
    "Referer": "https://nika-assistant.example.com",
    "Title": "NikaAssistant"
  },
  "Storage": {
    "OneTimeTasksPath": "%USERPROFILE%\\NikaAssistant\\Tasks\\OneTime\\one-time-tasks.md",
    "RecurringTasksPath": "%USERPROFILE%\\NikaAssistant\\Tasks\\Recurring\\recurring-tasks.md",
    "MonthlyTasksPath": "%USERPROFILE%\\NikaAssistant\\Tasks\\Monthly\\monthly-tasks.md",
    "YearlyTasksPath": "%USERPROFILE%\\NikaAssistant\\Tasks\\Yearly\\yearly-tasks.md",
    "OneTimeArchivePath": "%USERPROFILE%\\NikaAssistant\\Tasks\\OneTime\\archive-one-time-tasks.md",
    "RecurringArchivePath": "%USERPROFILE%\\NikaAssistant\\Tasks\\Recurring\\archive-recurring-tasks.md",
    "MonthlyArchivePath": "%USERPROFILE%\\NikaAssistant\\Tasks\\Monthly\\archive-monthly-tasks.md",
    "YearlyArchivePath": "%USERPROFILE%\\NikaAssistant\\Tasks\\Yearly\\archive-yearly-tasks.md",
    "DefaultAssignee": "Олеся"
  }
}
